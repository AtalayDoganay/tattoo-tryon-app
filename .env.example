# =============================================================================
# TattooAR — environment variable template
# =============================================================================
# Copy to `.env` and fill in real values. `.env` is git-ignored; this template
# must only ever contain placeholders.
#
#   cp .env.example .env
#
# -----------------------------------------------------------------------------
# HOW TO READ THIS FILE
# -----------------------------------------------------------------------------
# Section A — CLIENT (EXPO_PUBLIC_*)
#   Expo inlines every EXPO_PUBLIC_* value into the JavaScript bundle at build
#   time. On web that bundle is downloadable by anyone; on native it can be
#   extracted from the app package. These values are therefore PUBLIC. That is
#   fine for the ones listed below — none of them grant privilege on their own.
#   The real security boundary is Supabase Row Level Security, not this file.
#
#   NEVER give a secret an EXPO_PUBLIC_ prefix.
#
# Section B — SERVER ONLY
#   These are real secrets. They are NOT read from this file by the app. Set
#   them directly in the hosting provider's dashboard (Railway / Supabase /
#   Vercel), where they stay out of the client bundle and out of git.
# =============================================================================


# -----------------------------------------------------------------------------
# A. CLIENT — safe to ship in the bundle (public by design)
# -----------------------------------------------------------------------------

# Supabase project REST URL, e.g. https://<project-ref>.supabase.co
# Required. Public: it is the endpoint the app talks to.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase PUBLISHABLE (a.k.a. anon) key — starts with `sb_publishable_`,
# or a legacy `eyJ...` anon JWT on older projects.
# Required. Public by design: it identifies the project and carries the `anon`
# role. It grants NOTHING that RLS does not explicitly allow. Rotating it does
# not add security; correct RLS policies do.
#
# NEVER put the `service_role` / `sb_secret_...` key here. That key bypasses
# RLS entirely and would hand every reader full database control.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key

# Public HTTPS URL of the deployed background-removal API (Railway).
# Required in production. Falls back to http://localhost:5001 for local dev.
EXPO_PUBLIC_BG_SERVER_URL=https://your-bg-server.up.railway.app


# -----------------------------------------------------------------------------
# B. SERVER ONLY — real secrets. Never prefix these with EXPO_PUBLIC_.
#    Never commit them. Never reference them from app/, components/, or lib/.
# -----------------------------------------------------------------------------

# --- bg_server (set these in the Railway service's Variables tab) ------------

# Comma-separated browser origins allowed to call the API via CORS.
# Exact scheme + host + port, no trailing slash, no wildcards in production.
# Native mobile apps are NOT browsers and do not need to be listed here.
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:8081

# Require a valid Supabase user access token on /remove-bg.
# "true" (recommended for production) or "false" for open/anonymous access.
# When false, the stricter anonymous rate limit applies instead.
# REQUIRE_AUTH=true

# Supabase project ref, used to build the JWKS URL that verifies user tokens.
# This is NOT a secret (it appears in the public project URL) but it belongs to
# the server's configuration, not the client bundle.
# SUPABASE_PROJECT_REF=your-project-ref

# Rate-limit storage. MUST be a shared Redis-compatible URI in production —
# the in-memory default is per-worker and silently under-counts across
# Gunicorn workers. Railway can provision a Redis service for this.
# RATELIMIT_STORAGE_URI=redis://default:REDACTED@host:6379

# Rate limits (Flask-Limiter syntax). Tune per environment.
# RATE_LIMIT_AUTHENTICATED=30 per hour
# RATE_LIMIT_ANONYMOUS=5 per hour
# RATE_LIMIT_DEFAULT=120 per hour

# Image intake limits.
# MAX_UPLOAD_BYTES=8388608          # 8 MiB request body cap
# MAX_IMAGE_PIXELS=16000000         # 16 MP decoded-pixel cap
# MAX_IMAGE_DIMENSION=6000          # max width/height in px
# PROCESS_TIMEOUT_SECONDS=25        # cap on a single rembg run

# LOG_LEVEL=INFO

# --- Supabase Edge Function secrets -----------------------------------------
# Set with: supabase secrets set HUGGINGFACE_TOKEN=...
# Read server-side only, inside the Deno function. Never exposed to clients.
# HUGGINGFACE_TOKEN=hf_REDACTED

# --- Never place these anywhere in this repository --------------------------
# The following are listed so reviewers recognise them on sight. If any of
# these ever appears in a committed file, treat it as an incident: rotate the
# credential first, then clean history.
#
#   SUPABASE_SERVICE_ROLE_KEY / sb_secret_...   bypasses all RLS
#   SUPABASE_JWT_SECRET                         forges any user session
#   SUPABASE_DB_PASSWORD / postgres://...       direct database access
#   RAILWAY_TOKEN                               redeploy/alter infrastructure
#   VERCEL_TOKEN                                redeploy/alter the website
#   GITHUB_TOKEN / ghp_... / github_pat_...     push to this repository
#   EXPO_TOKEN                                  publish builds as you
#   *.p8 / *.p12 / *.jks / *.keystore           app signing identity
